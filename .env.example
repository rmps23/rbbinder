# Supabase project settings (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Accounts (Supabase Auth): the same project URL and its publishable (anon) key.
# With these set, people sign up / sign in with email + password or Google and
# each sees only their own binders, bulk and decks.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Emails allowed to run Data & updates (card sync, prices...), comma separated.
# The first admin to sign in also gets every binder/bulk/deck from before accounts.
ADMIN_EMAILS=you@example.com

# Without the NEXT_PUBLIC_ keys above (e.g. running locally without Supabase)
# the site falls back to a single password:
SITE_PASSWORD=change-me
# Random long string used to sign that login cookie
SESSION_SECRET=change-me-too-please-make-it-long-and-random
