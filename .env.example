# Supabase project settings (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password to access the site (you choose this)
SITE_PASSWORD=change-me

# Random long random string used to sign the login cookie (any random string works)
SESSION_SECRET=change-me-too-please-make-it-long-and-random
